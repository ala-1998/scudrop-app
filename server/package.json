{
  "name": "scudrop-backend",
  "version": "1.0.0",
  "description": "Standalone backend API for Scudrop FR (Orders, Expenses, Stats, File Uploads)",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx index.ts",
    "build": "esbuild index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mongoose": "^9.9.5",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
