# Standalone Backend Configuration
PORT=5000
HOST=0.0.0.0

# Optional MongoDB connection string (e.g. MongoDB Atlas)
# If not provided, the backend seamlessly uses durable JSON storage in ./data/
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/scudrop?retryWrites=true&w=majority

# URL of the deployed frontend (for CORS security)
CLIENT_URL=https://my-scudrop-frontend.vercel.app
